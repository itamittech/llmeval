# Copy to .env and fill in. Never commit .env.
#
# Nothing here is needed to run the engine, its tests, the conformance check,
# or to replay recorded games — that is deliberate. Keys are only required once
# a stack actually calls a model.
#
# A stack started without the keys it needs must fail immediately, naming the
# missing variable, rather than dying mid-turn after spending tokens.

# --- Direct provider APIs (the "direct" access route of ADR-0005) ----------
ANTHROPIC_API_KEY=

# --- AWS (the "bedrock" access route) -------------------------------------
# Prefer the standard credential chain: SSO, a named profile, or an instance
# role. Only set explicit keys if you have no alternative.
AWS_REGION=us-east-1
AWS_PROFILE=

# --- Optional ---------------------------------------------------------------
# Per-game spend ceiling, enforced by the harness as a hard stop.
LUDO_MAX_COST_USD=
# OpenTelemetry collector endpoint, if you are running one.
OTEL_EXPORTER_OTLP_ENDPOINT=
