# Secrets — never committed. See .env.example for the required variables.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Java
target/
*.class

# Node
node_modules/
.vite/

# Recorded games are committed only when curated as samples.
projects/*/games/scratch/

# Claude Code: settings.json is shared, settings.local.json is per-machine.
.claude/settings.local.json

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
